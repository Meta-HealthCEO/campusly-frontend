# Copy to .env.local for local development.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4500/api

# Development-only one-click sign-in panel on /login. Shown only by `next dev`
# (NODE_ENV=development) with this set to true; production builds drop it.
# The backend must also run with DEV_SIGN_IN=true.
NEXT_PUBLIC_DEV_SIGN_IN=false
